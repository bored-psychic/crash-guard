# Copy to `.env` and fill in. config.load_dotenv() reads this automatically for
# the CLI scripts, CTOL's LLM proposer, and the FastAPI server — no export needed.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: hosted crash-classifier endpoint (REASON v2 — see modal_app.py).
# When set, the learned model screens every candidate before the VLM; when
# unset, CrashGuard runs exactly as before.
# CRASH_MODEL_URL=https://<you>--crashguard-reason-crashclassifier-classify.modal.run
